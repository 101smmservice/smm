{
  "name": "@persona/core",
  "version": "0.0.0",
  "private": true,
  "description": "Persona core: domain model, account lifecycle state machine, events and storage contracts",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}

{
  "name": "@persona/account-intake",
  "version": "0.0.0",
  "private": true,
  "description": "Persona account intake: manual, ownership-confirmed intake of accounts into the system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@persona/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
